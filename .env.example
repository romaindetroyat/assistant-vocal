# --- Obligatoire ---
ANTHROPIC_API_KEY=sk-ant-...
# Requis seulement si la clé n'est pas rattachée à un espace de travail (console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
ASSISTANT_PASSWORD=choisissez-un-mot-de-passe-long
SESSION_SECRET=une-longue-chaine-aleatoire

# --- Modèle ---
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# --- Serveur ---
PORT=3000
DATA_DIR=./data
# Nom affiché et prénom de l'utilisateur, utilisés dans le prompt système
ASSISTANT_NAME=Assistant
USER_NAME=Romain

# --- Notifications push (générer avec: npm run vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@example.com

# --- Transcription des vocaux enregistrés (optionnel, API multipart compatible /v1/audio/transcriptions) ---
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=

# --- Jetons des serveurs MCP (noms libres, référencés par authorization_token_env dans mcp.config.json) ---
MCP_AGENDA_TOKEN=
MCP_GMAIL_TOKEN=
