{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "assistant-vocal",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "DATA", "id": "86626561bfdf4aae803f9d00762e69fe" }],
  // Coffre de documents : décommenter quand R2 est activé et le bucket créé (sinon les fichiers vont dans KV).
  // "r2_buckets": [{ "binding": "DOCS", "bucket_name": "assistant-vocal-documents" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ASSISTANT_NAME": "Assistant",
    "USER_NAME": "Romain",
    "CLAUDE_MODEL": "claude-opus-5-5",
    "CLAUDE_EFFORT": "medium",
    "VAPID_SUBJECT": "mailto:romaindetroyat@gmail.com",
    "MCP_URL_AGENDA": "https://agenda-hub-cyan.vercel.app/api/mcp",
    "MCP_AUTH_AGENDA": "oauth"
  },
  "observability": { "enabled": true }
}
