{
  "manifest_version": 3,
  "name": "Assistant vocal",
  "version": "1.0.0",
  "description": "Ouvre l'assistant vocal d'un raccourci clavier et lui envoie la page, un lien ou une sélection depuis le menu contextuel.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Assistant vocal",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["contextMenus", "storage", "tabs", "scripting", "windows", "notifications"],
  "host_permissions": ["https://assistant-vocal.romaindetroyat.workers.dev/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "commands": {
    "parler": {
      "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "MacCtrl+Shift+Space" },
      "description": "Ouvrir l'assistant et parler"
    },
    "envoyer-page": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "MacCtrl+Shift+E" },
      "description": "Envoyer la page à l'assistant"
    },
    "ouvrir": {
      "suggested_key": { "default": "Ctrl+Shift+A", "mac": "MacCtrl+Shift+A" },
      "description": "Ouvrir l'assistant"
    }
  }
}
